generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }
enum ProviderStatus { ENABLED DISABLED DEGRADED }
enum RequestStatus { PENDING COMPLETED FAILED }
model Application { id String @id @default(uuid()); name String; slug String @unique; enabled Boolean @default(true); apiKeys ApiKey[]; requests LlmRequest[]; usage UsageRecord[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model ApiKey { id String @id @default(uuid()); applicationId String; name String; prefix String @unique; keyHash String; enabled Boolean @default(true); lastUsedAt DateTime?; expiresAt DateTime?; revokedAt DateTime?; application Application @relation(fields:[applicationId],references:[id],onDelete:Cascade); createdAt DateTime @default(now()); @@index([applicationId,enabled]) }
model Provider { id String @id @default(uuid()); slug String @unique; displayName String; status ProviderStatus @default(ENABLED); baseUrl String?; models Model[]; healthChecks ProviderHealth[]; usage UsageRecord[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model ProviderHealth { id String @id @default(uuid()); providerId String; healthy Boolean; latencyMs Int?; statusCode Int?; details String?; provider Provider @relation(fields:[providerId],references:[id],onDelete:Cascade); checkedAt DateTime @default(now()); @@index([providerId,checkedAt]) }
model Model { id String @id @default(uuid()); providerId String; providerModel String; displayName String; enabled Boolean @default(true); contextWindow Int; maxOutputTokens Int; supportsTools Boolean @default(false); supportsJson Boolean @default(false); supportsStreaming Boolean @default(false); qualityScore Float @default(0.5); speedScore Float @default(0.5); costScore Float @default(0.5); reliabilityScore Float @default(0.5); inputCostPerMillion Decimal? @db.Decimal(12,6); outputCostPerMillion Decimal? @db.Decimal(12,6); provider Provider @relation(fields:[providerId],references:[id],onDelete:Cascade); taskScores ModelTaskScore[]; attempts LlmAttempt[]; usage UsageRecord[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@unique([providerId,providerModel]); @@index([enabled]) }
model ModelTaskScore { id String @id @default(uuid()); modelId String; taskType String; score Float; sampleSize Int @default(0); model Model @relation(fields:[modelId],references:[id],onDelete:Cascade); updatedAt DateTime @updatedAt; @@unique([modelId,taskType]) }
model LlmRequest { id String @id @default(uuid()); applicationId String; externalId String? @unique; traceId String @unique; taskType String; mode String; status RequestStatus @default(PENDING); errorCode String?; application Application @relation(fields:[applicationId],references:[id]); attempts LlmAttempt[]; usage UsageRecord[]; createdAt DateTime @default(now()); completedAt DateTime?; @@index([applicationId,createdAt]); @@index([status,createdAt]) }
model LlmAttempt { id String @id @default(uuid()); requestId String; modelId String; attemptNumber Int; success Boolean; providerRequestId String?; inputTokens Int?; outputTokens Int?; latencyMs Int?; estimatedCostUsd Decimal? @db.Decimal(12,6); errorCode String?; request LlmRequest @relation(fields:[requestId],references:[id],onDelete:Cascade); model Model @relation(fields:[modelId],references:[id]); createdAt DateTime @default(now()); @@unique([requestId,attemptNumber]); @@index([modelId,createdAt]) }
model UsageRecord { id String @id @default(uuid()); applicationId String; providerId String; modelId String; requestId String; inputTokens Int @default(0); outputTokens Int @default(0); estimatedCostUsd Decimal @db.Decimal(12,6); application Application @relation(fields:[applicationId],references:[id]); provider Provider @relation(fields:[providerId],references:[id]); model Model @relation(fields:[modelId],references:[id]); request LlmRequest @relation(fields:[requestId],references:[id],onDelete:Cascade); createdAt DateTime @default(now()); @@index([applicationId,createdAt]); @@index([providerId,createdAt]); @@index([modelId,createdAt]) }
