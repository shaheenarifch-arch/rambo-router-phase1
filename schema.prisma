generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

enum RequestStatus { PENDING COMPLETED FAILED }
enum ProviderStatus { ENABLED DISABLED DEGRADED }

model Application {
  id        String   @id @default(uuid())
  name      String   @unique
  apiKeyHash String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  requests  LlmRequest[]
}

model Provider {
  id        String @id @default(uuid())
  slug      String @unique
  status    ProviderStatus @default(ENABLED)
  createdAt DateTime @default(now())
  models    Model[]
}

model Model {
  id             String @id @default(uuid())
  providerId     String
  providerModel  String
  displayName    String
  enabled        Boolean @default(true)
  contextWindow  Int
  maxOutputTokens Int
  supportsTools  Boolean @default(false)
  supportsJson   Boolean @default(false)
  qualityScore   Float @default(0.5)
  speedScore     Float @default(0.5)
  costScore      Float @default(0.5)
  provider       Provider @relation(fields: [providerId], references: [id])
  attempts       LlmAttempt[]
  @@unique([providerId, providerModel])
}

model LlmRequest {
  id            String @id @default(uuid())
  applicationId String
  externalId    String? @unique
  taskType      String
  mode          String
  status        RequestStatus @default(PENDING)
  createdAt     DateTime @default(now())
  completedAt   DateTime?
  application   Application @relation(fields: [applicationId], references: [id])
  attempts      LlmAttempt[]
}

model LlmAttempt {
  id            String @id @default(uuid())
  requestId     String
  modelId       String
  providerRequestId String?
  inputTokens   Int?
  outputTokens  Int?
  latencyMs     Int?
  estimatedCost Decimal? @db.Decimal(12, 6)
  success       Boolean
  errorCode     String?
  createdAt     DateTime @default(now())
  request       LlmRequest @relation(fields: [requestId], references: [id])
  model         Model @relation(fields: [modelId], references: [id])
}
