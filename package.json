{
  "name": "@rambo/api",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.1.0",
    "@rambo/core": "workspace:*",
    "@rambo/providers": "workspace:*",
    "@rambo/router": "workspace:*",
    "@rambo/schemas": "workspace:*",
    "fastify": "^5.1.0",
    "zod": "^3.23.8",
    "@rambo/database": "workspace:*",
    "@rambo/auth": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
